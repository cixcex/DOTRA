{
  "name": "dotra",
  "private": true,
  "version": "1.4.0",
  "description": "DOTRA — Transform any image into a beautifully crafted, genuinely scannable QR code. Every dot tells a story.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "gen:samples": "node scripts/generate-samples.mjs",
    "gen:assets": "node scripts/bundle-run.mjs scripts/generate-assets.ts",
    "test:engine": "node scripts/bundle-run.mjs scripts/test-engine.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/space-grotesk": "^5.2.0",
    "delaunator": "^5.1.0",
    "framer-motion": "^11.18.2",
    "gifenc": "^1.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.81.0",
    "mp4-muxer": "^5.2.2",
    "qrcode-generator": "^1.4.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "keywords": [
    "qr-code",
    "qr",
    "generator",
    "react",
    "typescript",
    "vite",
    "tailwindcss",
    "jsqr",
    "image-processing",
    "client-side"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cixcex/DOTRA.git"
  },
  "bugs": {
    "url": "https://github.com/cixcex/DOTRA/issues"
  },
  "homepage": "https://github.com/cixcex/DOTRA#readme"
}
